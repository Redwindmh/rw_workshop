---
interface Props { number: string; title: string; href?: string; linkText?: string; }
const { number, title, href, linkText = 'View all' } = Astro.props;
---
<header class="section-heading">
  <div><span class="section-number">{number}</span><h2>{title}</h2></div>
  {href && <a class="section-link" href={href}>{linkText} <span aria-hidden="true">→</span></a>}
</header>
