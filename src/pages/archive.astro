---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const projects=await getCollection('projects'); const logs=await getCollection('logs');
const tags = new Map<string,number>(); [...projects,...logs].forEach((e:any)=>e.data.tags.forEach((t:string)=>tags.set(t,(tags.get(t)||0)+1)));
const tagList=[...tags.entries()].sort((a,b)=>b[1]-a[1]);
const years=[...new Set([...projects.map(p=>p.data.started.getFullYear()),...logs.map(l=>l.data.date.getFullYear())])].sort((a,b)=>b-a);
---
<BaseLayout title="Archive">
<section class="page-hero compact-hero"><div class="eyebrow"><span></span> Specimen vault</div><h1>The archive</h1><p>Everything eventually ends up here: projects, transmissions, disciplines, tools, and technologies.</p></section>
<section class="content-section archive-page"><div class="archive-summary"><div><Icon name="projects" size={26}/><strong>{projects.length}</strong><span>Projects</span></div><div><Icon name="logs" size={26}/><strong>{logs.length}</strong><span>Field logs</span></div><div><Icon name="archive" size={26}/><strong>{tagList.length}</strong><span>Tags</span></div><div><Icon name="now" size={26}/><strong>{years.length}</strong><span>Years</span></div></div><div class="archive-columns"><section><h2>By technology</h2><div class="tag-index">{tagList.map(([tag,count])=><span><strong>{tag}</strong><small>{count}</small></span>)}</div></section><section><h2>By year</h2><div class="year-index">{years.map(year=><div><strong>{year}</strong><span>{projects.filter(p=>p.data.started.getFullYear()===year).length} projects · {logs.filter(l=>l.data.date.getFullYear()===year).length} logs</span></div>)}</div></section></div></section>
</BaseLayout>
